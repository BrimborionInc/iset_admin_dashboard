{
  "id": "iset-compliance-v1",
  "label": "ISET Compliance Checklist",
  "version": "2026-01-20",
  "gates": [
    {
      "id": "submit_application",
      "label": "Gate 1 - Submit Application",
      "statusScope": "application",
      "statuses": [
        "submitted",
        "in_review",
        "docs_requested",
        "closure_notice",
        "pending_approval"
      ],
      "items": [
        {
          "id": "identity-document",
          "label": "Identity document",
          "scope": "per client (once)",
          "sources": [
            "application_submission",
            "manual_upload",
            "secure_message_attachment"
          ],
          "required": true,
          "documentTypes": [
            "identity_document"
          ],
          "notes": "Front and back, but a single image of both is OK."
        },
        {
          "id": "indigenous-declaration",
          "label": "Indigenous declaration",
          "scope": "per client (once)",
          "sources": [
            "application_form"
          ],
          "required": true,
          "documentTypes": [
            "indigenous_declaration"
          ],
          "notes": "Auto-generated when the application is submitted."
        },
        {
          "id": "letter-of-reference",
          "label": "Letter of Reference",
          "scope": "per client (once)",
          "sources": [
            "application_submission",
            "manual_upload",
            "secure_message_attachment"
          ],
          "required": false,
          "documentTypes": [
            "letter_of_reference"
          ],
          "notes": "Alternative to the status/treaty card. If used, two letters of reference are required."
        },
        {
          "id": "resume",
          "label": "Resume",
          "scope": "per client (once)",
          "sources": [
            "application_submission",
            "manual_upload",
            "secure_message_attachment"
          ],
          "required": true,
          "documentTypes": [
            "resume"
          ],
          "notes": "One per client, but must be kept up to date."
        },
        {
          "id": "status-or-treaty-card",
          "label": "Status or Treaty Card",
          "scope": "per client (once)",
          "sources": [
            "application_submission",
            "manual_upload",
            "secure_message_attachment"
          ],
          "required": false,
          "documentTypes": [
            "status_card"
          ],
          "notes": "Either the status/treaty card (front and back) OR two letters of reference are required."
        },
        {
          "id": "band-or-nation-funding-decision-letter",
          "label": "Band or Nation funding Decision letter",
          "scope": "per application",
          "sources": [
            "application_submission",
            "manual_upload",
            "secure_message_attachment"
          ],
          "required": true,
          "documentTypes": [
            "band_funding_confirmation",
            "band_funding_denial",
            "band_funding_decision"
          ],
          "notes": "Either a funding approval or denial letter is required."
        },
        {
          "id": "conflict-of-interest-form",
          "label": "Conflict of Interest Form",
          "scope": "per application",
          "sources": [
            "application_form"
          ],
          "required": true,
          "documentTypes": [
            "conflict_of_interest"
          ],
          "notes": "Auto-generated when the application is submitted."
        },
        {
          "id": "letter-of-acceptance",
          "label": "Letter of Acceptance",
          "scope": "per application",
          "sources": [
            "application_submission",
            "manual_upload",
            "secure_message_attachment"
          ],
          "required": true,
          "documentTypes": [
            "acceptance_letter"
          ],
          "notes": "Required for applications other than 'Self-employment Support'."
        },
        {
          "id": "medical-documentation",
          "label": "Medical documentation",
          "scope": "per application",
          "sources": [
            "application_submission",
            "manual_upload",
            "secure_message_attachment"
          ],
          "required": true,
          "documentTypes": [
            "medical_documentation"
          ],
          "notes": "Required only if the client is requesting funding related to disability support."
        },
        {
          "id": "evidence-of-expense",
          "label": "Evidence of Expense (lease/mortgage statement; 3 months of utility bills, childcare, etc.)",
          "scope": "per assessment (application or new intervention proposal)",
          "sources": [
            "application_submission",
            "manual_upload",
            "secure_message_attachment"
          ],
          "required": true,
          "documentTypes": [
            "financial_evidence"
          ],
          "notes": "Checked during assessment to ensure there were no omissions."
        },
        {
          "id": "evidence-of-income",
          "label": "Evidence of Income (paystubs; CTB statement; ROE, T4s, etc.)",
          "scope": "per assessment (application or new intervention proposal)",
          "sources": [
            "application_submission",
            "manual_upload",
            "secure_message_attachment"
          ],
          "required": true,
          "documentTypes": [
            "financial_records"
          ],
          "notes": "What is mandatory depends on what was declared in the application (e.g., spousal income)."
        }
      ]
    },
    {
      "id": "start_assessment",
      "label": "Gate 2 - Start Assessment",
      "statusScope": "application",
      "statuses": [
        "submitted",
        "in_review",
        "docs_requested",
        "closure_notice",
        "pending_approval"
      ],
      "items": [
        {
          "id": "ei-consent-form",
          "label": "EI Consent Form",
          "scope": "per application / action plan",
          "sources": [
            "application_form"
          ],
          "required": true,
          "documentTypes": [
            "ei_consent"
          ],
          "notes": "EI assessment is completed first (after the conflict-of-interest check; once staff unlock the assessment form)."
        },
        {
          "id": "ei-eligibility-verification",
          "label": "EI Eligibility Verification",
          "scope": "per application / action plan",
          "sources": [
            "application_submission",
            "manual_upload",
            "secure_message_attachment"
          ],
          "required": true,
          "documentTypes": [
            "ei_verification"
          ],
          "notes": "EI assessment is completed first (after the conflict-of-interest check; once staff unlock the assessment form)."
        },
        {
          "id": "case-manager-assessment",
          "label": "Case manager assessment",
          "scope": "per assessment (new application or new intervention for an active participant)",
          "sources": [
            "application_form"
          ],
          "required": true,
          "documentTypes": [
            "case_assessment"
          ],
          "notes": "Auto-generated PDF of the completed assessment."
        }
      ]
    },
    {
      "id": "submit_assessment",
      "label": "Gate 3 - Submit Assessment",
      "statusScope": "application",
      "statuses": [
        "submitted",
        "in_review",
        "docs_requested",
        "closure_notice",
        "pending_approval"
      ],
      "items": [
        {
          "id": "evidence-of-expense-submit-assessment",
          "label": "Evidence of Expense (lease/mortgage statement; 3 months of utility bills, childcare, etc.)",
          "scope": "per assessment (application or new intervention proposal)",
          "sources": [
            "application_submission",
            "manual_upload",
            "secure_message_attachment"
          ],
          "required": true,
          "documentTypes": [
            "financial_evidence"
          ],
          "notes": "Checked during assessment to ensure there were no omissions."
        },
        {
          "id": "evidence-of-income-submit-assessment",
          "label": "Evidence of Income (paystubs; CTB statement; ROE, T4s, etc.)",
          "scope": "per assessment (application or new intervention proposal)",
          "sources": [
            "application_submission",
            "manual_upload",
            "secure_message_attachment"
          ],
          "required": true,
          "documentTypes": [
            "financial_records"
          ],
          "notes": "What is mandatory depends on what was declared in the application (e.g., spousal income)."
        },
        {
          "id": "application-form",
          "label": "Application form",
          "scope": "per application",
          "sources": [
            "application_form"
          ],
          "required": true,
          "documentTypes": [
            "application_form"
          ],
          "notes": "Auto-generated PDF when the assessment is submitted (includes any corrections)."
        },
        {
          "id": "financial-overview-budget",
          "label": "Financial overview/budget",
          "scope": "per funding agreement / action plan",
          "sources": [
            "application_form"
          ],
          "required": true,
          "documentTypes": [
            "financial_overview"
          ],
          "notes": "Auto-generated PDF when the assessment is submitted (includes any corrections to financial tables)."
        }
      ]
    },
    {
      "id": "deny",
      "label": "Gate 4 - Deny",
      "statusScope": "application",
      "statuses": [
        "closure_notice",
        "rejected",
        "declined"
      ],
      "items": [
        {
          "id": "decision-letter-deny",
          "label": "Decision Letter",
          "scope": "per application",
          "sources": [
            "manual_upload"
          ],
          "required": true,
          "documentTypes": [
            "assessment_denial_letter"
          ],
          "notes": "Approval or denial letter, as applicable."
        }
      ]
    },
    {
      "id": "approve",
      "label": "Gate 5 - Approve",
      "statusScope": "application",
      "statuses": [
        "pending_approval"
      ],
      "items": [
        {
          "id": "decision-letter-approve",
          "label": "Decision Letter",
          "scope": "per application",
          "sources": [
            "manual_upload"
          ],
          "required": true,
          "documentTypes": [
            "assessment_approval_letter"
          ],
          "notes": "Approval or denial letter, as applicable."
        }
      ]
    },
    {
      "id": "approve_and_commence",
      "label": "Gate 6 - Approve and Commence",
      "statusScope": "application",
      "statuses": [
        "decision_ready",
        "approved",
        "completed"
      ],
      "items": [
        {
          "id": "funding-agreement",
          "label": "Funding agreement",
          "scope": "per application / new action plan",
          "sources": [
            "application_submission",
            "manual_upload",
            "secure_message_attachment"
          ],
          "required": true,
          "documentTypes": [
            "funding_agreement"
          ],
          "notes": "Must be updated and re-signed if circumstances or the action plan change (e.g., added intervention)."
        },
        {
          "id": "authorization-for-release-of-iset-client-information",
          "label": "Authorization for release of ISET client information",
          "scope": "per funding agreement / action plan",
          "sources": [
            "application_submission",
            "manual_upload",
            "secure_message_attachment"
          ],
          "required": true,
          "documentTypes": [
            "iset_client_info_release"
          ]
        },
        {
          "id": "client-acknowledgement-of-funding-source",
          "label": "Client Acknowledgement of Funding Source",
          "scope": "per funding agreement / action plan",
          "sources": [
            "application_submission",
            "manual_upload",
            "secure_message_attachment"
          ],
          "required": true,
          "documentTypes": [
            "client_acknowledgement"
          ],
          "notes": "Mandatory for non-zero-cost action plans (i.e., where an approved intervention has costs)."
        },
        {
          "id": "eft-or-wire-transfer-form",
          "label": "EFT or Wire Transfer Form",
          "scope": "per funding agreement / action plan (reusable if details unchanged)",
          "sources": [
            "application_submission",
            "manual_upload",
            "secure_message_attachment"
          ],
          "required": true,
          "documentTypes": [
            "EFT_form"
          ],
          "notes": "Mandatory for non-zero-cost action plans; reusable if details have not changed."
        },
        {
          "id": "mou-co-funding-agreement-letter",
          "label": "MOU/Co-Funding Agreement Letter",
          "scope": "per funding agreement",
          "sources": [
            "application_submission",
            "manual_upload",
            "secure_message_attachment"
          ],
          "required": true,
          "documentTypes": [
            "mou_co_funding_agreement_letter"
          ],
          "notes": "If the client is part funded for this funding agreement from another source (e.g., Band or Province)."
        },
        {
          "id": "voided-cheque",
          "label": "Voided Cheque",
          "scope": "per funding agreement / action plan (reusable if details unchanged)",
          "sources": [
            "application_submission",
            "manual_upload",
            "secure_message_attachment"
          ],
          "required": true,
          "documentTypes": [
            "voided_cheque"
          ],
          "notes": "Mandatory for non-zero-cost action plans; reusable if details have not changed."
        }
      ]
    },
    {
      "id": "propose_new_intervention",
      "label": "Gate 7 - Propose New Intervention",
      "statusScope": "case",
      "statuses": [
        "active",
        "dormant",
        "ready_to_close"
      ],
      "items": []
    },
    {
      "id": "send_payment_packet_to_finance",
      "label": "Gate 8 - Send Payment Packet to Finance",
      "statusScope": "case",
      "statuses": [
        "initiated",
        "active",
        "dormant",
        "ready_to_close"
      ],
      "items": [
        {
          "id": "alternate-payee-letter",
          "label": "Alternate payee letter",
          "scope": "per payment packet line item",
          "sources": [
            "application_submission",
            "manual_upload",
            "secure_message_attachment"
          ],
          "required": false,
          "documentTypes": [
            "alternate_payee_letter"
          ],
          "notes": "If needed."
        },
        {
          "id": "employer-duties-letter",
          "label": "Employer duties letter",
          "scope": "per payment packet line item",
          "sources": [
            "application_submission",
            "manual_upload",
            "secure_message_attachment"
          ],
          "required": false,
          "documentTypes": [
            "employer_duties_letter"
          ],
          "notes": "If needed for the payment packet line-item category."
        },
        {
          "id": "employer-offer-letter-after-subsidy",
          "label": "Employer offer letter after subsidy",
          "scope": "per payment packet line item",
          "sources": [
            "application_submission",
            "manual_upload",
            "secure_message_attachment"
          ],
          "required": false,
          "documentTypes": [
            "employer_offer_letter_after_subsidy"
          ],
          "notes": "If needed for the payment packet line-item category."
        },
        {
          "id": "equipment-quote",
          "label": "Equipment quote",
          "scope": "per payment packet line item",
          "sources": [
            "application_submission",
            "manual_upload",
            "secure_message_attachment"
          ],
          "required": false,
          "documentTypes": [
            "equipment_quote"
          ],
          "notes": "If needed for the payment packet line-item category."
        },
        {
          "id": "institution-letter",
          "label": "Institution letter",
          "scope": "per payment packet line item",
          "sources": [
            "application_submission",
            "manual_upload",
            "secure_message_attachment"
          ],
          "required": false,
          "documentTypes": [
            "institution_letter"
          ],
          "notes": "If needed."
        },
        {
          "id": "receipt",
          "label": "Receipt",
          "scope": "per payment packet line item",
          "sources": [
            "application_submission",
            "manual_upload",
            "secure_message_attachment"
          ],
          "required": false,
          "documentTypes": [
            "receipt"
          ],
          "notes": "If needed for the payment packet line-item category."
        },
        {
          "id": "wage-plan-mercs-schedule",
          "label": "Wage plan / MERCs schedule",
          "scope": "per payment packet line item",
          "sources": [
            "application_submission",
            "manual_upload",
            "secure_message_attachment"
          ],
          "required": false,
          "documentTypes": [
            "wage_plan"
          ],
          "notes": "If needed for the payment packet line-item category."
        }
      ]
    },
    {
      "id": "trigger_recurring_payment",
      "label": "Gate 9 - Trigger a Recurring Payment",
      "statusScope": "case",
      "statuses": [
        "initiated",
        "active",
        "dormant",
        "ready_to_close"
      ],
      "items": [
        {
          "id": "attendance-form",
          "label": "Attendance form",
          "scope": "per recurring payment",
          "sources": [
            "application_submission",
            "manual_upload",
            "secure_message_attachment"
          ],
          "required": true,
          "documentTypes": [
            "attendance_form"
          ],
          "notes": "Monthly."
        }
      ]
    },
    {
      "id": "on_demand",
      "label": "On-demand (not tied to a specific gate)",
      "statusScope": "application",
      "statuses": [
        "submitted",
        "in_review",
        "docs_requested",
        "closure_notice",
        "pending_approval"
      ],
      "items": [
        {
          "id": "media-consent",
          "label": "Media consent",
          "scope": "per client (once)",
          "sources": [
            "application_submission",
            "manual_upload",
            "secure_message_attachment"
          ],
          "required": false,
          "documentTypes": [
            "media_consent"
          ],
          "notes": "Not tied to a specific gate; request if/when needed."
        }
      ]
    }
  ]
}
