  "scripts": {
    "dev": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File ../ISET-intake/start-dev.ps1",
    "start": "node scripts/write-build-info.js --build-target local-start && set PORT=3001 && react-scripts start",
    "build": "node scripts/write-build-info.js --build-target build && react-scripts build",
    "build:development": "node scripts/write-build-info.js --build-target development && env-cmd -f .env.development react-scripts build",
    "build:test": "node scripts/write-build-info.js --build-target test && env-cmd -f .env.test react-scripts build",
    "build:production": "node scripts/write-build-info.js --build-target production && env-cmd -f .env.production react-scripts build",
    "test": "react-scripts test",
    "test:payments:safety": "react-scripts test --watchAll=false --runTestsByPath src/pages/finance/widgets/__tests__/paymentsWorkflowSafety.test.js",
    "payments:workflow:smoke": "node scripts/payments-workflow-smoke.js",
    "payments:workflow:smoke:api": "node scripts/payments-workflow-smoke.js --api",
    "payments:workflow:smoke:browser": "node scripts/payments-workflow-smoke.js --browser",
    "eject": "react-scripts eject",
    "server": "set ENABLE_UNSAFE_ADMIN_DEBUG_ROUTES=true&& nodemon isetadminserver.js",
    "dump:dev-schema": "env-cmd -f .env node scripts/dump-dev-db-structure.js",
    "lint": "eslint --ext .js,.jsx src",
    "audit:parity": "node scripts/parity-audit.js",
    "audit:privacy-erm": "node scripts/privacy-erm-audit.js",
    "smoke:privacy-erm": "node scripts/privacy-erm-smoke.js",
    "smoke:privacy-routes": "node scripts/privacy-route-scope-smoke.js",
    "seed:privacy-denials": "node scripts/seed-privacy-denial-fixtures.js",
    "smoke:privacy-denials": "node scripts/privacy-route-denial-smoke.js",
    "workflow:apply-upload-camera-chooser": "node scripts/apply-intake-upload-camera-chooser.js",
    "workflow:set-file-upload-max-size-floor": "node scripts/set-file-upload-max-size-floor.js",
    "fixtures:workflows": "node scripts/generate-workflow-fixtures.js",
    "sync:portal-renderers": "node scripts/sync-portal-renderers.js",
    "ai:inventory": "node scripts/admin-ai-inventory.js",
    "ai:eval:check": "node scripts/admin-ai-eval-fixtures-check.js",
    "db:migrate:inventory": "node scripts/path-schema-migrate.js inventory",
    "db:migrate:plan": "node scripts/path-schema-migrate.js plan",
    "db:migrate:apply": "node scripts/path-schema-migrate.js apply",
    "assessment:backfill:plan": "node scripts/application-assessment-backfill.js",
    "assessment:backfill:apply": "node scripts/application-assessment-backfill.js --apply",
    "assessment:context:plan": "node scripts/application-assessment-context-backfill.js",
    "assessment:context:apply": "node scripts/application-assessment-context-backfill.js --apply",
    "assessment:option-b:smoke": "node scripts/application-assessment-option-b-smoke.js",
    "path:deploy": "node scripts/path-deploy.js",
    "path:deploy:plan": "node scripts/path-deploy.js plan",
    "path:deploy:smoke": "node scripts/path-deploy.js smoke",
    "path:maintenance": "node scripts/path-maintenance.js",
    "path:maintenance:fallback": "node scripts/path-maintenance-fallback.js",
    "data:sync:catalog": "node scripts/path-data-sync.js catalog",
    "data:sync:plan": "node scripts/path-data-sync.js plan",
    "data:sync:bundle": "node scripts/path-data-sync.js bundle",
    "data:sync:apply": "node scripts/path-data-sync.js apply",
    "test:db:refresh": "node scripts/path-test-db-refresh.js run",
    "test:db:refresh:plan": "node scripts/path-test-db-refresh.js plan",
    "deploy-admin-prod": "powershell -ExecutionPolicy Bypass -File scripts/deploy-admin-prod.ps1",
    "deploy-admin-to-prod": "powershell -ExecutionPolicy Bypass -File scripts/deploy-admin-prod.ps1",
    "deploy-shared-to-prod": "powershell -ExecutionPolicy Bypass -File scripts/deploy-shared-prod.ps1",
    "configure-prod-portal-hosts": "powershell -ExecutionPolicy Bypass -File scripts/configure-prod-portal-hosts.ps1",
    "refresh-prod": "powershell -ExecutionPolicy Bypass -File scripts/start-prod-instance-refresh.ps1",
    "deploy-admin-to-test": "powershell -ExecutionPolicy Bypass -File scripts/deploy-admin-test.ps1",
    "deploy:test-db": "node scripts/path-test-db-refresh.js run"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "string-replace-loader": "^3.1.0"
