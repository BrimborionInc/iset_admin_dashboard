{
    "RoleName": "nwac-prod-app-role",
    "PolicyName": "nwac-prod-cognito-admin",
    "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
            {
                "Effect": "Allow",
                "Action": [
                    "cognito-idp:ListUsers",
                    "cognito-idp:ListUsersInGroup",
                    "cognito-idp:ListGroups",
