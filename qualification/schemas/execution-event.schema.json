{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:path:release-qualification:execution-event:1.0.0-draft.1",
  "title": "PATH Release Qualification Execution Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaName",
    "schemaVersion",
    "artifactId",
    "createdAt",
    "producer",
    "lineageScope",
    "productCandidateId",
    "harnessVersion",
    "attemptId",
    "testPackVersions",
    "parentArtifactRefs",
    "contentDigest",
    "lifecycleState",
    "completeness",
    "sensitivity",
    "redaction",
    "retentionPolicyRef",
    "planRef",
    "attemptSequence",
    "producerSequence",
    "eventType",
    "occurredAt",
    "recordedAt"
  ],
  "properties": {
    "schemaName": {
      "const": "path.release-qualification.execution-event"
    },
    "schemaVersion": {
      "const": "1.0.0-draft.1"
    },
    "artifactId": {
      "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/opaqueId"
    },
    "createdAt": {
      "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/canonicalTimestamp"
    },
    "producer": {
      "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/producer"
    },
    "lineageScope": {
      "const": "attempt"
    },
    "productCandidateId": {
      "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/productCandidateIdentity"
    },
    "harnessVersion": {
      "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/harnessIdentity"
    },
    "attemptId": {
      "$ref": "#/$defs/attemptId"
    },
    "environmentIdentityRef": {
      "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/artifactRef"
    },
    "testPackVersions": {
      "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/testPackVersions"
    },
    "parentArtifactRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/artifactRef"
      }
    },
    "relatedArtifactRefs": {
      "type": "array",
      "items": {
        "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/relatedArtifactRef"
      }
    },
    "contentDigest": {
      "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/digest"
    },
    "lifecycleState": {
      "$ref": "#/$defs/lifecycleState"
    },
    "completeness": {
      "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/completeness"
    },
    "sensitivity": {
      "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/sensitivity"
    },
    "redaction": {
      "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/redaction"
    },
    "retentionPolicyRef": {
      "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/retentionPolicyRef"
    },
    "planRef": {
      "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/artifactRef"
    },
    "attemptSequence": {
      "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/positiveInteger"
    },
    "producerSequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "eventType": {
      "enum": [
        "state-transition",
        "dispatch",
        "process-observation",
        "progress",
        "output-chunk",
        "attachment",
        "timeout",
        "cancellation-request",
        "termination-action",
        "mutation-boundary",
        "validation-observation",
        "storage-observation"
      ]
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fromState",
        "toState",
        "triggeringEvidenceRefs",
        "transitionRuleVersion"
      ],
      "properties": {
        "fromState": {
          "$ref": "#/$defs/lifecycleState"
        },
        "toState": {
          "$ref": "#/$defs/lifecycleState"
        },
        "triggeringEvidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/artifactRef"
          }
        },
        "transitionRuleVersion": {
          "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/versionString"
        }
      }
    },
    "checkInstanceId": {
      "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/opaqueId"
    },
    "packId": {
      "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/opaqueId"
    },
    "packVersion": {
      "type": "string",
      "minLength": 1
    },
    "adapterRef": {
      "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/artifactRef"
    },
    "commandDeclarationRef": {
      "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/artifactRef"
    },
    "occurredAt": {
      "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/canonicalTimestamp"
    },
    "recordedAt": {
      "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/canonicalTimestamp"
    },
    "processOrJobRef": {
      "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/opaqueId"
    },
    "effectTokens": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/opaqueId"
      }
    },
    "mutationState": {
      "enum": [
        "not-started",
        "may-have-started",
        "started",
        "terminal"
      ]
    },
    "timeout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "configuredBudgetMs",
        "elapsedMs",
        "lastActivitySequence",
        "deadline"
      ],
      "properties": {
        "kind": {
          "enum": [
            "startup",
            "execution",
            "idle",
            "cleanup",
            "finalization",
            "total-attempt"
          ]
        },
        "configuredBudgetMs": {
          "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/positiveInteger"
        },
        "elapsedMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lastActivitySequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "deadline": {
          "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/canonicalTimestamp"
        }
      }
    },
    "cancellation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cause",
        "requesterAuthority",
        "target",
        "requestedSequence",
        "requestedAt",
        "graceDeadline",
        "forceDeadline"
      ],
      "properties": {
        "cause": {
          "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/opaqueId"
        },
        "requesterAuthority": {
          "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/opaqueId"
        },
        "target": {
          "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/opaqueId"
        },
        "requestedSequence": {
          "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/positiveInteger"
        },
        "requestedAt": {
          "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/canonicalTimestamp"
        },
        "graceDeadline": {
          "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/canonicalTimestamp"
        },
        "forceDeadline": {
          "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/canonicalTimestamp"
        }
      }
    },
    "termination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "terminalProved"
      ],
      "properties": {
        "action": {
          "enum": [
            "graceful-request",
            "forced-tree-termination",
            "remote-cancel"
          ]
        },
        "terminalProved": {
          "type": "boolean"
        },
        "terminalResultRef": {
          "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/artifactRef"
        },
        "failureReason": {
          "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/opaqueId"
        }
      }
    },
    "streamRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stream",
        "streamSequence",
        "byteStart",
        "byteEnd",
        "attachmentRef",
        "capturedBytes",
        "truncated"
      ],
      "properties": {
        "stream": {
          "enum": [
            "stdout",
            "stderr"
          ]
        },
        "streamSequence": {
          "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/positiveInteger"
        },
        "byteStart": {
          "type": "integer",
          "minimum": 0
        },
        "byteEnd": {
          "type": "integer",
          "minimum": 0
        },
        "attachmentRef": {
          "$ref": "#/$defs/attachmentRef"
        },
        "capturedBytes": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "attachmentRef": {
      "$ref": "#/$defs/attachmentRef"
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "milestoneId",
        "heartbeat"
      ],
      "properties": {
        "milestoneId": {
          "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/opaqueId"
        },
        "heartbeat": {
          "type": "boolean"
        }
      }
    },
    "lateOrConflict": {
      "enum": [
        "late",
        "duplicate-identical",
        "duplicate-conflicting",
        "out-of-order",
        "stale"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "state-transition"
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "required": [
          "transition"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "timeout"
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "required": [
          "timeout",
          "mutationState"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "cancellation-request"
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "required": [
          "cancellation",
          "mutationState"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "termination-action"
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "required": [
          "termination",
          "mutationState"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "output-chunk"
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "required": [
          "streamRef"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "attachment"
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "required": [
          "attachmentRef"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "progress"
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "required": [
          "progress"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "mutation-boundary"
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "required": [
          "effectTokens",
          "mutationState"
        ]
      }
    }
  ],
  "$defs": {
    "attemptId": {
      "type": "string",
      "pattern": "^attempt:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "lifecycleState": {
      "enum": [
        "ATTEMPT_OPENED",
        "PREREQUISITES_EVALUATING",
        "ENVIRONMENT_PROVING",
        "PREREQUISITES_PASSED",
        "PREREQUISITE_FAILED",
        "CHECK_PENDING",
        "CHECK_READY",
        "CHECK_BLOCKED",
        "CHECK_DISPATCHED",
        "CHECK_RUNNING",
        "CHECK_COMPLETED",
        "CHECK_FAILED",
        "CHECK_TIMED_OUT",
        "CHECK_CANCELLING",
        "CHECK_CANCELLED",
        "TERMINATION_FAILED",
        "CLEANUP_UNNECESSARY",
        "CLEANUP_REQUIRED",
        "CLEANUP_RUNNING",
        "CLEANUP_SUCCEEDED",
        "CLEANUP_FAILED",
        "CLEANUP_INTERRUPTED",
        "RESIDUE_PROVING",
        "RESIDUE_PROOF_COMPLETED",
        "RESIDUE_PROOF_FAILED",
        "RESIDUE_UNNECESSARY",
        "ATTEMPT_FINALIZING",
        "FINAL_EVIDENCE_EMITTED",
        "FINALIZATION_INTERRUPTED",
        "INDEPENDENT_VALIDATION_RUNNING",
        "VALIDATION_ACCEPTED",
        "VALIDATION_REJECTED",
        "ADVISORY_RESULT_AVAILABLE"
      ]
    },
    "attachmentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mediaType",
        "byteSize",
        "contentDigest",
        "sensitivity",
        "retentionClass",
        "producer"
      ],
      "properties": {
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "byteSize": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "contentDigest": {
          "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/digest"
        },
        "sensitivity": {
          "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/sensitivity"
        },
        "retentionClass": {
          "enum": [
            "release-core",
            "attempt-diagnostic",
            "sensitive-media",
            "build-and-rollback",
            "rejected-or-interrupted",
            "ephemeral-cache"
          ]
        },
        "producer": {
          "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/producer"
        },
        "logicalPurpose": {
          "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/opaqueId"
        }
      }
    }
  }
}
