{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:path:release-qualification:final-evidence:1.0.0-draft.2",
  "title": "PATH qualification final evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaName", "schemaVersion", "artifactId", "createdAt", "producer",
    "lineageScope", "productCandidateId", "harnessVersion", "attemptId",
    "testPackVersions", "parentArtifactRefs", "contentDigest",
    "lifecycleState", "completeness", "sensitivity", "redaction",
    "retentionPolicyRef", "planRef", "planDigest", "identitySummary",
    "requestedScope", "selectedScope", "prerequisiteResults", "eventGraph",
    "checkResults", "failures", "cancellationAndTermination",
    "cleanupAndResidue", "attachmentIndex", "missingOrPartialEvidence",
    "blockers", "decisionRuleRef", "producerAdvisoryStatus",
    "validationHandoff"
  ],
  "properties": {
    "schemaName": { "const": "path.release-qualification.final-evidence" },
    "schemaVersion": { "const": "1.0.0-draft.2" },
    "artifactId": { "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/opaqueId" },
    "createdAt": { "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/canonicalTimestamp" },
    "producer": { "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/producer" },
    "lineageScope": { "const": "attempt" },
    "productCandidateId": { "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/productCandidateIdentity" },
    "harnessVersion": { "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/harnessIdentity" },
    "attemptId": { "$ref": "#/$defs/attemptId" },
    "environmentIdentityRef": { "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/artifactRef" },
    "testPackVersions": { "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/testPackVersions" },
    "parentArtifactRefs": { "$ref": "#/$defs/nonEmptyArtifactRefs" },
    "relatedArtifactRefs": { "$ref": "#/$defs/relatedArtifactRefs" },
    "contentDigest": { "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/digest" },
    "lifecycleState": { "enum": ["FINAL_EVIDENCE_EMITTED", "FINALIZATION_INTERRUPTED"] },
    "completeness": { "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/completeness" },
    "sensitivity": { "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/sensitivity" },
    "redaction": { "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/redaction" },
    "retentionPolicyRef": { "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/retentionPolicyRef" },
    "planRef": { "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/artifactRef" },
    "planDigest": { "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/digest" },
    "identitySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productCandidateId", "harnessVersion", "attemptId", "environmentProofRefs", "testPackVersions"],
      "properties": {
        "productCandidateId": { "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/productCandidateIdentity" },
        "harnessVersion": { "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/harnessIdentity" },
        "attemptId": { "$ref": "#/$defs/attemptId" },
        "environmentProofRefs": { "$ref": "#/$defs/artifactRefs" },
        "testPackVersions": { "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/testPackVersions" }
      }
    },
    "requestedScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planScopeRef", "scopeDigest"],
      "properties": {
        "planScopeRef": { "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/artifactRef" },
        "scopeDigest": { "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/digest" }
      }
    },
    "selectedScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks", "dependencyDigest", "selectionInputDigest", "selectionOutputDigest"],
      "properties": {
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["checkInstanceId", "packId", "packVersion", "inclusionOrigins", "dependencyRefs"],
            "properties": {
              "checkInstanceId": { "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/opaqueId" },
              "packId": { "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/opaqueId" },
              "packVersion": { "type": "string", "minLength": 1 },
              "inclusionOrigins": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["mandatory-core", "impacted-domain", "dependency", "explicit-suite", "scheduled-full", "release-operation"] } },
              "dependencyRefs": { "$ref": "#/$defs/artifactRefs" }
            }
          }
        },
        "dependencyDigest": { "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/digest" },
        "selectionInputDigest": { "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/digest" },
        "selectionOutputDigest": { "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/digest" }
      }
    },
    "prerequisiteResults": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gateId", "status", "proofRefs", "affectedCheckInstanceIds"],
        "properties": {
          "gateId": { "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/opaqueId" },
          "status": { "enum": ["passed", "failed", "blocked"] },
          "proofRefs": { "$ref": "#/$defs/artifactRefs" },
          "environmentCapabilityRefs": { "$ref": "#/$defs/artifactRefs" },
          "affectedCheckInstanceIds": { "$ref": "#/$defs/opaqueIdArray" }
        }
      }
    },
    "eventGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventRefs", "firstSequence", "lastSequence", "missingRanges", "quarantinedEventRefs", "graphDigest"],
      "properties": {
        "eventRefs": { "$ref": "#/$defs/nonEmptyArtifactRefs" },
        "firstSequence": { "type": "integer", "minimum": 1 },
        "lastSequence": { "type": "integer", "minimum": 1 },
        "missingRanges": { "type": "array", "items": { "$ref": "#/$defs/sequenceRange" } },
        "quarantinedEventRefs": { "$ref": "#/$defs/artifactRefs" },
        "graphDigest": { "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/digest" }
      }
    },
    "checkResults": { "$ref": "#/$defs/nonEmptyArtifactRefs" },
    "failures": { "$ref": "#/$defs/artifactRefs" },
    "cancellationAndTermination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionRefs", "terminationRequired", "terminationProved"],
      "properties": {
        "actionRefs": { "$ref": "#/$defs/artifactRefs" },
        "terminationRequired": { "type": "boolean" },
        "terminationProved": { "type": "boolean" }
      }
    },
    "cleanupAndResidue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obligationIds", "cleanupResultRefs", "residueDecision", "unresolvedEffects", "escalationRefs"],
      "properties": {
        "obligationIds": { "$ref": "#/$defs/opaqueIdArray" },
        "cleanupResultRefs": { "$ref": "#/$defs/artifactRefs" },
        "residueDecision": { "enum": ["not-applicable", "zero-residue", "residue-found", "unknown"] },
        "unresolvedEffects": { "$ref": "#/$defs/opaqueIdArray" },
        "escalationRefs": { "$ref": "#/$defs/artifactRefs" }
      }
    },
    "attachmentIndex": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attachmentRef", "mediaType", "sizeBytes", "sensitivity", "retentionClass", "availability"],
        "properties": {
          "attachmentRef": { "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/artifactRef" },
          "mediaType": { "type": "string", "minLength": 1 },
          "sizeBytes": { "type": "integer", "minimum": 0 },
          "sensitivity": { "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/sensitivity" },
          "retentionClass": { "enum": ["release-core", "attempt-diagnostic", "sensitive-media", "build-and-rollback", "rejected-or-interrupted", "ephemeral-cache"] },
          "availability": { "enum": ["available", "missing", "corrupt", "redacted"] }
        }
      }
    },
    "missingOrPartialEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "lastTrustworthyState", "unknownEffects", "residueUncertainty"],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "status", "blocker"],
            "properties": {
              "code": { "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/opaqueId" },
              "status": { "enum": ["missing", "corrupt", "stale", "conflicting", "late", "truncated"] },
              "artifactRef": { "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/artifactRef" },
              "blocker": { "type": "boolean" }
            }
          }
        },
        "lastTrustworthyState": { "type": "string", "minLength": 1 },
        "unknownEffects": { "$ref": "#/$defs/opaqueIdArray" },
        "residueUncertainty": { "type": "boolean" }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "evidenceRefs"],
        "properties": {
          "code": { "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/opaqueId" },
          "evidenceRefs": { "$ref": "#/$defs/nonEmptyArtifactRefs" }
        }
      }
    },
    "decisionRuleRef": { "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/artifactRef" },
    "producerAdvisoryStatus": { "enum": ["GO", "NO-GO", "INCOMPLETE"] },
    "validationHandoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reconstructionInputRefs", "validatorVersion", "selfApproved"],
      "properties": {
        "reconstructionInputRefs": { "$ref": "#/$defs/nonEmptyArtifactRefs" },
        "validatorVersion": { "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/versionString" },
        "selfApproved": { "const": false }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "producerAdvisoryStatus": { "const": "GO" } }, "required": ["producerAdvisoryStatus"] },
      "then": {
        "properties": {
          "lifecycleState": { "const": "FINAL_EVIDENCE_EMITTED" },
          "completeness": { "properties": { "state": { "const": "complete" } } },
          "failures": { "maxItems": 0 },
          "blockers": { "maxItems": 0 },
          "eventGraph": { "properties": { "missingRanges": { "maxItems": 0 }, "quarantinedEventRefs": { "maxItems": 0 } } },
          "missingOrPartialEvidence": { "properties": { "items": { "maxItems": 0 }, "unknownEffects": { "maxItems": 0 }, "residueUncertainty": { "const": false } } },
          "cancellationAndTermination": { "properties": { "terminationProved": { "const": true } }, "allOf": [{ "if": { "properties": { "terminationRequired": { "const": false } } }, "then": true }] },
          "cleanupAndResidue": { "properties": { "residueDecision": { "enum": ["not-applicable", "zero-residue"] }, "unresolvedEffects": { "maxItems": 0 }, "escalationRefs": { "maxItems": 0 } } }
        }
      }
    },
    {
      "if": { "properties": { "producerAdvisoryStatus": { "const": "INCOMPLETE" } }, "required": ["producerAdvisoryStatus"] },
      "then": { "properties": { "completeness": { "properties": { "state": { "enum": ["partial", "interrupted"] } } }, "blockers": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "lifecycleState": { "const": "FINALIZATION_INTERRUPTED" } }, "required": ["lifecycleState"] },
      "then": { "properties": { "producerAdvisoryStatus": { "const": "INCOMPLETE" } } }
    }
  ],
  "$defs": {
    "attemptId": { "type": "string", "pattern": "^attempt:[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "artifactRefs": { "type": "array", "items": { "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/artifactRef" } },
    "nonEmptyArtifactRefs": { "type": "array", "minItems": 1, "items": { "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/artifactRef" } },
    "relatedArtifactRefs": { "type": "array", "items": { "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/relatedArtifactRef" } },
    "opaqueIdArray": { "type": "array", "uniqueItems": true, "items": { "$ref": "urn:path:release-qualification:qualification-plan:1.0.0-draft.2#/$defs/opaqueId" } },
    "sequenceRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first", "last"],
      "properties": { "first": { "type": "integer", "minimum": 1 }, "last": { "type": "integer", "minimum": 1 } }
    }
  }
}
